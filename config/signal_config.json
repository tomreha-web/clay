  "_tier_note": "Tier A = strong institutional-settlement intent (the 'Head of Stablecoin at Apple' pattern). Tier B = broad terms that also match retail crypto and engineering noise; they trigger only when a seniority term is also present.",

  "seniority": {
    "required": ["head", "director", "vp", "vice president", "lead"],
    "suggested": ["svp", "evp", "managing director", "chief", "general manager", "global head"]
  },

  "negative_title_terms": [
    "intern", "internship", "recruiter", "talent acquisition", "sales development",
    "customer support", "teller", "cashier", "fraud", "anti-money laundering investigator"
  ],
  "_negative_note": "Titles with these terms never trigger. 'fraud' is there because 'crypto fraud investigator' roles at banks are compliance hires, not buyers. Review with the customer.",

